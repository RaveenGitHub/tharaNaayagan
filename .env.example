# ==============================================================================
# Enterprise Playwright Automation Framework - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize for your target test environment.
# The committed persona values below are local demo credentials only. Never use them
# against QA, UAT, production, or another shared environment.
# Non-local browser targets require ALLOW_NON_LOCAL_TEST_TARGET=true and dedicated
# environment credentials for every persona. See docs/test-strategy-template.md.

# ------------------------------------------------------------------------------
# Target URLs & Service Endpoints
# The default browser and development API target must remain local.
# ------------------------------------------------------------------------------
BASE_URL=http://127.0.0.1:4173
API_BASE_URL=http://127.0.0.1:4173/api

QA_BASE_URL=https://qa.example.com
QA_API_BASE_URL=https://qa.example.com/api

UAT_BASE_URL=https://uat.example.com
UAT_API_BASE_URL=https://uat.example.com/api

PROD_BASE_URL=https://example.com
PROD_API_BASE_URL=https://example.com/api

# ------------------------------------------------------------------------------
# Local-only demo persona credentials. Replace all values with dedicated test
# accounts before opting into any non-local target.
# ------------------------------------------------------------------------------
E2E_ADMIN_USER=admin@example.com
E2E_ADMIN_PASSWORD=Admin@123

E2E_USER_USER=user@example.com
E2E_USER_PASSWORD=User@123

E2E_GUEST_USER=guest@example.com
E2E_GUEST_PASSWORD=Guest@123

E2E_API_USER=api.client@example.com
E2E_API_PASSWORD=Api@123

# ------------------------------------------------------------------------------
# Reporting & Runtime Settings
# ------------------------------------------------------------------------------
ALLURE_RESULTS=allure-results
# CI=true
